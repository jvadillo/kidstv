# Copia este archivo a .env.production en el servidor (no se sube al repositorio).
APP_NAME=KidsTV
# Genera con: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=https://kidstv.jonvadillo.com
APP_LOCALE=es
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=info

# Envío de correos (códigos de acceso). Con MAIL_MAILER=log los correos quedan en
# los logs del contenedor (útil solo mientras no haya proveedor configurado).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@kidstv.jonvadillo.com
MAIL_FROM_NAME=KidsTV

# Límites de almacenamiento (MB). El VPS es compartido: ajusta según el disco libre.
KIDSTV_MAX_VIDEO_MB=500
KIDSTV_MAX_AUDIO_MB=60
KIDSTV_FAMILY_QUOTA_MB=3072
KIDSTV_MIN_FREE_DISK_MB=1536
